{
  "name": "terrablock",
  "version": "5.3.4",
  "description": "TerraBlock Desktop — 3D voxel Terraria-scale adventure",
  "private": true,
  "type": "module",
  "main": "electron/main.mjs",
  "author": "WPAI",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "desktop": "npm run build && electron .",
    "desktop:dev": "node electron/dev.mjs",
    "desktop:pack": "npm run build && electron-builder --win",
    "desktop:dir": "npm run build && electron-builder --win --dir",
    "test": "node --test tests/**/*.test.js",
    "lint": "eslint . --max-warnings 0",
    "verify": "node scripts/verify.mjs",
    "playtest": "node playtest/run.mjs --mode smoke --seed 42 --clean",
    "playtest:agent": "node playtest/run.mjs --mode agent --seed 42 --clean --steps 40",
    "playtest:headed": "node playtest/run.mjs --mode smoke --seed 42 --headed --clean",
    "playtest:agent:headed": "node playtest/run.mjs --mode agent --seed 42 --headed --steps 30",
    "mp-server": "node server/mp-server.mjs"
  },
  "dependencies": {
    "three": "0.185.1",
    "ws": "8.21.1"
  },
  "devDependencies": {
    "electron": "37.2.0",
    "electron-builder": "26.0.12",
    "eslint": "9.30.1",
    "globals": "16.3.0",
    "playwright": "1.61.1",
    "vite": "8.1.1"
  },
  "build": {
    "appId": "com.wpai.terrablock",
    "productName": "TerraBlock",
    "copyright": "Copyright © WPAI",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json",
      "!local/**/*",
      "!**/local/textures/**"
    ],
    "extraMetadata": {
      "main": "electron/main.mjs"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "TerraBlock-${version}-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "TerraBlock"
    },
    "portable": {
      "artifactName": "TerraBlock-${version}-portable.exe"
    }
  }
}
